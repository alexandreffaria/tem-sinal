<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower. They must exclude the same data as
   data_extraction_rules.xml, which applies on Android 12 and higher.
   The sample files contain exact locations and times, so they never leave the device.
   The app keeps no databases of its own; any there belong to libraries, so none is backed up.
   The app keeps none of its own state in shared preferences; everything there is Firebase's
   per-install state, including the signed-in anonymous user, so none of it is backed up or
   transferred. An app setting added to shared preferences would not be backed up either.
   The list of recordings, recordings.json, is neither backed up nor transferred: its
   recordings can be deleted only with the install id they were sent with, which is in
   noBackupFilesDir and never restored, so a restored list would offer a Delete that can't work.
   The one file of app state in filesDir that is backed up and transferred,
   first_log_warning_shown, holds no location data, and a restored phone need not show the
   first-LOG warning again.
-->
<full-backup-content>
    <exclude domain="file" path="signal_log.json" />
    <exclude domain="file" path="signal_log.pending.json" />
    <exclude domain="file" path="signal_log.rejected.json" />
    <exclude domain="file" path="signal_log.last.json" />
    <exclude domain="file" path="signal_log.last.json.tmp" />
    <exclude domain="file" path="recordings.json" />
    <exclude domain="file" path="recordings.json.tmp" />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
