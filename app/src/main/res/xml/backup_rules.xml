<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower. They must exclude the same data as
   data_extraction_rules.xml, which applies on Android 12 and higher.
   The sample files and Firestore's local cache (the database domain, which holds
   the samples written to it) contain exact locations and times, so they
   never leave the device.
-->
<full-backup-content>
    <exclude domain="file" path="signal_log.json" />
    <exclude domain="file" path="signal_log.pending.json" />
    <exclude domain="file" path="signal_log.rejected.json" />
    <exclude domain="database" path="." />
</full-backup-content>
