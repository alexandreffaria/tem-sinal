<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Firebase Auth's dependencies add reCAPTCHA's permission and the Google Sign-In and
         Credential Manager components below. The app signs in only anonymously, which needs none
         of them. -->
    <uses-permission
        android:name="com.google.android.providers.gsf.permission.READ_GSERVICES"
        tools:node="remove" />

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CellSignalMapper"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CellSignalMapper"
            android:configChanges="orientation|screenSize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".LoggerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Google Sign-In and Credential Manager components, removed as said above. The Google
             Sign-In classes are only on the runtime classpath, which lint doesn't see. -->
        <activity
            android:name="com.google.android.gms.auth.api.signin.internal.SignInHubActivity"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <service
            android:name="com.google.android.gms.auth.api.signin.RevocationBoundService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <activity
            android:name="androidx.credentials.playservices.HiddenActivity"
            tools:node="remove" />
        <service
            android:name="androidx.credentials.playservices.CredentialProviderMetadataHolder"
            tools:node="remove" />
    </application>

</manifest>